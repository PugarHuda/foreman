# Copy to .env and fill in, or just run `npm run keys` — it creates this file
# and generates every burner key below that is still blank.
#
# .env is gitignored. Never commit it.

# --- keys ---
# Burner keys for Base Sepolia only. Never put real funds behind these.
# `npm run keys` generates any that are missing and writes the matching
# addresses, so the only one you normally touch is the RPC and the API key.
DEPLOYER_KEY=
AGENT_KEY=
SUPPLIER_A_KEY=
SUPPLIER_B_KEY=

# Derived from the keys above by `npm run keys`. The NEXT_PUBLIC_ ones reach
# the browser, which is fine — they are addresses, not secrets.
NEXT_PUBLIC_AGENT_ADDRESS=
NEXT_PUBLIC_SUPPLIER_A=
NEXT_PUBLIC_SUPPLIER_B=

# --- chain ---
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Settle in Circle's real testnet USDC instead of a deployed mock. Requires the
# deployer to already hold some — https://faucet.circle.com gives 20 USDC every
# two hours, which is why the mock is the default for demos.
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=

# Optional. Only needed to verify on Etherscan; Blockscout and Sourcify need
# no key, and `npx hardhat verify` uses all three.
ETHERSCAN_API_KEY=

# --- agent ---
# https://venice.ai/settings/api
VENICE_API_KEY=
# Optional. Pins the first model tried; lib/agent.ts falls back through
# others if it is unavailable.
VENICE_MODEL=zai-org-glm-5-2

# --- delivery proof ---
# Stands in for a carrier-issued waybill number: it makes the despatch
# reference unguessable, which is what makes goods-in matching it mean
# anything. Must be the same everywhere the app runs.
#
# Do not rotate this while orders are in flight. The reference is derived from
# it, so a rotation leaves every already-Shipped order unconfirmable and its
# escrow stuck until the 14-day supplier timeout.
DELIVERY_SALT=

# --- public deployment ---
# Only needed if you deploy this somewhere public. See lib/guard.ts — the
# write endpoints refuse to serve in production without it.
DEMO_SECRET=
NEXT_PUBLIC_DEMO_SECRET=

# --- filled in by `npm run deploy` ---
NEXT_PUBLIC_FOREMAN_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# =====================================================================
# PILOT — everything below is off by default. Leave it blank and the app
# runs the demo exactly as before: simulated telemetry, fixture stock,
# fixture quotes, DEMO_SECRET gate.
# =====================================================================

# --- telemetry ---
# sim  (default) replay the synthetic run-to-failure signature
# file           read per-machine CSVs written by /api/telemetry or dropped in
TELEMETRY_SOURCE=
TELEMETRY_DIR=data/telemetry

# Bearer token a gateway or scripts/telemetry-bridge.mjs presents to
# POST /api/telemetry. Separate from the operator password on purpose: a
# leaked gateway token cannot spend anything, and rotating the operator
# password does not silence the sensors. `npm run passwd` generates one.
TELEMETRY_TOKEN=

# --- the asset register ---
# JSON array of machines. Without it the three fixture machines are used.
# [{ "id": 1, "tag": "CNC-07", "name": "...", "criticalPart": "6205-2RS",
#    "escalationPart": "SPN-880", "downtimeCostPerHour": 890 }]
MACHINES_FILE=

# --- stock and purchasing ---
# fixture (default) the tables in lib/plant.ts
# http              a REST endpoint in front of the ERP/CMMS, serving
#                   GET /stock/:partNo   -> { "onHand": 3 }
#                   GET /quotes/:partNo  -> [{ supplier, address, priceUsd, leadTimeHours }]
#                   GET /parts/:partNo   -> { "description": "..." }
PLANT_SOURCE=
PLANT_API_URL=
PLANT_API_TOKEN=

# --- operator login ---
# Run `npm run passwd 'your password'` and paste both lines here. Setting
# OPERATOR_PASSWORD_HASH turns off the DEMO_SECRET gate: the password never
# reaches the browser and the session cookie is HttpOnly.
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=

# --- bridge (on-prem, reads the plant and posts to the app) ---
FOREMAN_URL=http://localhost:3000
TELEMETRY_BATCH_MS=5000
# npm i mqtt        then: npm run bridge -- --source mqtt
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=plant/cnc07/rms=CNC-07
# npm i node-opcua  then: npm run bridge -- --source opcua
OPCUA_URL=opc.tcp://localhost:4840
OPCUA_NODES=ns=2;s=CNC07.RMS=CNC-07
OPCUA_INTERVAL_MS=1000

# --- mainnet (CHAIN=base) ---
# The only setting where a mistake costs money. lib/safety.ts refuses to serve
# the money routes without a real operator password, a signable SESSION_SECRET,
# and Circle's canonical USDC for the chain.
CHAIN=
BASE_RPC=https://mainnet.base.org

# --- remote signer (put the agent key in a KMS) ---
# Sends a 32-byte digest, expects a 65-byte signature. Any KMS fits behind it.
# Per-role: AGENT_SIGNER_URL / PLANT_SIGNER_URL / SUPPLIERA_SIGNER_URL …
# plus the matching *_SIGNER_ADDRESS. REMOTE_SIGNER_URL sets one for all roles.
AGENT_SIGNER_URL=
AGENT_SIGNER_ADDRESS=
