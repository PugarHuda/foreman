# Copy to .env and fill in. .env is gitignored — never commit it.

# Burner key for Base Sepolia only. Never put real funds here.
DEPLOYER_KEY=0x...
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Venice AI — https://venice.ai/settings/api
VENICE_API_KEY=
VENICE_MODEL=claude-opus-5

# Settle in Circle's real testnet USDC instead of a deployed mock. Requires the
# deployer to already hold some — https://faucet.circle.com gives 20 USDC every
# two hours, which is why the mock is the default for demos.
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=

# Only needed if you deploy this somewhere public. See lib/guard.ts — the
# write endpoints refuse to serve in production without it.
DEMO_SECRET=
NEXT_PUBLIC_DEMO_SECRET=

# Filled in by `npm run deploy`
NEXT_PUBLIC_FOREMAN_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
