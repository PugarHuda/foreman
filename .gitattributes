# Normalise line endings in the repository so a Windows checkout does not
# produce a whole-file diff on a Linux one. Without this every commit from a
# machine with core.autocrlf=true warns about LF becoming CRLF.
* text=auto eol=lf

# Binary, and large. Never try to diff or normalise these.
*.png binary
*.webm binary
*.jpg binary

# Generated by scripts/deploy.mjs. Collapsed in reviews because the ABI is one
# enormous line and the diff is never worth reading.
lib/deployment.ts linguist-generated=true

# Solidity is not detected reliably enough to be worth guessing at.
*.sol linguist-language=Solidity
